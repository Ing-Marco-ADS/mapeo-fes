{
  "expo": {
    "name": "Mapeo FES",
    "slug": "mapeo-fes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mapeofes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mapeofes.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para guiarte por los senderos accesibles de la FES.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Necesitamos tu ubicación para avisarte por voz cuando te acercas a puntos de interés."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F4E79",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mapeofes.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Necesitamos tu ubicación para guiarte por los senderos accesibles de la FES y avisarte de puntos cercanos."
        }
      ]
    ]
  }
}